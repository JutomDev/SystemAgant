# ==============================================================================
# SystemAgant — Runtime Environment Configuration
# ==============================================================================

# Execution mode:
# - 'simulation'  : 100% offline deterministic replay from recorded runs (Default, 0 tokens, no keys needed)
# - 'gemini-free' : Live execution via Google AI Studio API key (Gemini 2.0/1.5 Flash Free Tier)
# - 'vertex'      : Legacy execution via Google Cloud Vertex AI (Requires GCP Project ID)
EXECUTION_MODE=gemini-free

# Optional: Google AI Studio API Key (Get free key from: https://aistudio.google.com/)
# Only needed when EXECUTION_MODE=gemini-free
GEMINI_API_KEY=

# Optional: GCP Project ID (Only needed when EXECUTION_MODE=vertex)
GCP_PROJECT_ID=
GCP_LOCATION=global

# Tactile Web Dashboard settings
WEB_HOST=127.0.0.1
WEB_PORT=8000
